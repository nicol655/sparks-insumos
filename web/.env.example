# Copy to .env and adjust. Never commit .env.

# Catalog data source. `mock` uses src/fixtures until the api/ service exists.
API_MODE=mock

# Base URL of the api/ service. Only read when API_MODE=http.
API_BASE_URL=http://api:8000

# Business WhatsApp number, digits only (country code + area + number).
NEXT_PUBLIC_WHATSAPP_NUMBER=5491168692694

# Announcement bar above the header (§03). `off` hides it site-wide.
NEXT_PUBLIC_ANNOUNCEMENT=on

# Public origin for Open Graph / hreflang absolute URLs. Optional in Docker.
# NEXT_PUBLIC_SITE_URL=https://example.com
