# Copy to docker/.env to override compose defaults locally. Never commit docker/.env.

# Host port for the storefront. Change it if 3000 is taken by another project.
WEB_PORT=3000

# Host ports for the API and Postgres. Change them if 8000 or 5432 are taken.
API_PORT=8000
POSTGRES_PORT=5432

# Local bootstrap account. The database stores only the hash. Not a production secret.
BOOTSTRAP_ADMIN_EMAIL=admin@sparksinsumos.com
BOOTSTRAP_ADMIN_PASSWORD=admin123456
SESSION_TTL_SECONDS=21600
